# https://www.nginx.com/resources/wiki/start/topics/examples/full/
user ${NGINX_USER} uucp;
worker_processes auto;
# Each worker may open this many files: every proxied request uses 2 (client + upstream), served files 1 more.
# Must stay above worker_connections (below). Docker's default soft limit (1024 with recent versions) is too low,
# the master sets this one while it's still root.
worker_rlimit_nofile 16384;

# https://github.com/docker-library/docs/tree/master/nginx#running-nginx-as-a-non-root-user
pid        /tmp/nginx.pid;

include /etc/nginx/modules-enabled/*.conf;

events {
	# <= worker_rlimit_nofile / 2 (a proxied request holds 2 connections)
	worker_connections 4096;
}

http {
	# Basic Settings
	sendfile on;
	tcp_nopush on;
	tcp_nodelay on;
	keepalive_timeout 65;
	types_hash_max_size 2048;
	# server_tokens off;

	# server_names_hash_bucket_size 64;
	# server_name_in_redirect off;

	include /etc/nginx/mime.types;
	default_type application/octet-stream;

	# SSL Settings
	ssl_session_cache shared:SSL:10m;
	ssl_session_timeout 1h;
	# TLS 1.0/1.1 are deprecated (RFC 8996) and refused by current browsers. Clients too old for TLS 1.2
	# (e.g. python 2.6, CentOS 5's curl) can still use plain HTTP on the ports that serve it.
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers on;
	# No 3DES: it was only there for TLS 1.0 clients, and is weak (SWEET32)
	ssl_ciphers EECDH+CHACHA20:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:!MD5;


	# https://github.com/docker-library/docs/tree/master/nginx#running-nginx-as-a-non-root-user
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp_path;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

	# Logging Settings
	# To the container's logs (`docker compose logs proxy`): docker rotates them (see the proxy's `logging` in
	# production.yml), while files in the container grew until it was recreated (/tmp/access.log reached GBs).
	# nginx's master opens them as root before starting the workers, so it works with any NGINX_USER.
	access_log /dev/stdout;
	error_log stderr;

	# Gzip Settings
	gzip on;
	gzip_disable "msie6";
	gzip_buffers 16 8k;
	gzip_vary on;
	gzip_min_length 1000;
	gzip_proxied    expired no-cache no-store private auth;
	# Above 4, responses are barely smaller but cost much more CPU (the host is shared and often busy)
	gzip_comp_level 4;
	# gzip_proxied any;
	# gzip_http_version 1.1;
	gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript text/csv image/svg+xml;

	# Caches open file descriptors and their size/mtime, saving open()+stat() calls.
	# It's *disabled* for the files under /s/ (snippets/qaboard-files.conf): they live on NFS and change while
	# runs write them. The web app follows logs by asking every 2s for the bytes after the end it knows
	# (Range: bytes=N-, webapp/src/components/logs/useLogTail.js): with a cached size, nginx would answer
	# "nothing new" for up to open_file_cache_valid seconds, and files truncated or rewritten in place
	# (re-runs) would be served with the wrong length. On top of that, nginx revalidates with stat(), which NFS
	# answers from its attribute cache (up to acregmax=60s): only open() forces NFS to check for changes.
	# Here it only helps with the web app's bundles and the docs (local volumes, replaced at deploys: at worst
	# an old index.html for open_file_cache_valid seconds, whose bundles are still served).
	open_file_cache max=10000 inactive=60s;
	open_file_cache_valid 30s;
	open_file_cache_min_uses 2;
	# don't cache "not found": a new deploy's files must show up at once
	open_file_cache_errors off;

	# Virtual Host Configs
	include /etc/nginx/conf.d/*.conf;
}
