# The production environment of the example site, for deployments/deploy.py (website/docs/backend-admin/deployment.mdx)
#   deployments/deploy.py ../qaboard-site/example/production.env up --version 1.2.0 --init  # first time
#   deployments/deploy.py ../qaboard-site/example/production.env up --version 1.2.1         # upgrades
#   deployments/deploy.py ../qaboard-site/example/production.env status|rollback|compose ...
# deploy.py runs docker compose in the qaboard repository, with QABOARD_SITE_DIR set to the folder with this folder:
# the shell's, or --site-dir, else the folder above this one when it's outside the qaboard repository.
# It keeps the deployed versions next to this file, and reads the secrets from .env here (see .env.example).
COMPOSE_PROJECT_NAME=qaboard_example
# Plain `docker compose --env-file ../qaboard-site/example/production.env ps` works too: compose reads QABOARD_SITE_DIR
# here when the shell doesn't set it, relative to the qaboard repository. In your site repository, cloned next to the
# qaboard repository: QABOARD_SITE_DIR=${QABOARD_SITE_DIR:-../qaboard-site}. A path, so it starts with . or /
QABOARD_SITE_DIR=${QABOARD_SITE_DIR:-./deployments}
COMPOSE_FILE=docker-compose.yml:production.yml:${QABOARD_SITE_DIR}/example/example.yml
# The web app's docs include site-docs/, the instructions for this site's users
QABOARD_SITE=example

# Runs before the deploy, in the qaboard repository, e.g. to mount autofs folders before they are bound in containers
QABOARD_DEPLOY_PRE_HOOK=${QABOARD_SITE_DIR}/example/before-deploy.sh

QABOARD_BACKEND_REPLICAS=2
QABOARD_UWSGI_PROCESSES=8
QABOARD_UWSGI_CHEAPER=4
QABOARD_UWSGI_CHEAPER_INITIAL=8
